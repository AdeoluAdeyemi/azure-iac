{
  "$schema": "https://learn.microsoft.com/en-us/azure/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "vnetName": {
      "type": "string",
      "defaultValue": "vnet-1",
      "metadata": {
        "description": "The name of the virtual network to be created."
      }
    },
    "vnetAddressPrefix": {
      "type": "string",
      "defaultValue": "192.168.0.0/16",
      "metadata": {
        "description": "The address prefix for the virtual network."
      }
    },
    "subnetName": {
      "type": "string",
      "defaultValue": "subnet-1",
      "metadata": {
        "description": "The name of the subnet to be created."
      }
    },
    "subnetAddressPrefix": {
      "type": "string",
      "defaultValue": "192.168.0.0/24",
      "metadata": {
        "description": "The address prefix for the subnet."
      } 
    }, 
    "subnetName2": {
      "type": "string",
      "defaultValue": "subnet-2",
      "metadata": {
        "description": "The name of the second subnet to be created."
      }
    },
    "subnetAddress2Prefix": {
      "type": "string",
      "defaultValue": "192.168.1.0/24",
      "metadata": {
        "description": "The address prefix for the second subnet."
      }
    }
  },
  "functions": [],
  "variables": {},
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2025-09-01",
      "name": "[parameters('vnetName')]",
      "location": "[resourceGroup().location]",
      "properties": {     
        "addressSpace": {
          "addressPrefixes": [ "[parameters('vnetAddressPrefix')]" ]
        },
        "subnets": [
            {
                "name": "[parameters('subnetName')]",
                "id": "",
                "properties": {
                    "addressPrefixes": [
                        "[parameters('subnetAddressPrefix')]"
                    ],
                    "delegations": [],
                    "privateEndpointNetworkPolicies": "Disabled",
                    "privateLinkServiceNetworkPolicies": "Enabled",
                    "defaultOutboundAccess": false
                }
            },
            {
                "name": "[parameters('subnetName2')]",
                "id": "",
                "properties": {
                    "addressPrefixes": [
                        "[parameters('subnetAddress2Prefix')]"
                    ],
                    "delegations": [],
                    "privateEndpointNetworkPolicies": "Disabled",
                    "privateLinkServiceNetworkPolicies": "Enabled",
                    "defaultOutboundAccess": false
                }
            }
        ]
      },
      "tags": {
        "CostCenter": "000",
        "Environment": "Development",
        "Service": "SCOLP",
        "Owner": "MDTP"
      }
    }
  ],
  "outputs": {}
}