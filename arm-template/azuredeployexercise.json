{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "diskStorageType": {
      "type": "string",
      "defaultValue": "Standard_LRS",
      "allowedValues": [
        "Standard_LRS",
        "Premium_LRS",
        "StandardSSD_LRS",
        "UltraSSD_LRS",
        "Premium_ZRS",
        "StandardSSD_ZRS",
        "PremiumV2_LRS"
      ],
      "metadata": {
        "description": "The storage type for the disk. Options are Standard_LRS, Premium_LRS, StandardSSD_LRS, UltraSSD_LRS."
      }
    },
    "diskName": {
      "type": "string",
      "defaultValue": "adeployexercise",
      "metadata": {
        "description": "The name of the disk to be created."
      }
    },
    "diskSizeGB": {
      "type": "int",
      "defaultValue": 32,
      "minValue": 20,
      "maxValue": 64,
      "metadata": {
        "description": "The size of the disk in GB."
      }
    }
  },
  "functions": [],
  "variables": {},
  "resources": [
    {
      "type": "Microsoft.Compute/disks",
      "apiVersion": "2026-03-02",
      "name": "[parameters('diskName')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "creationData": {
          "createOption": "Empty"
        },
        "diskSizeGB": "[parameters('diskSizeGB')]"
      },
      "sku": {
        "name": "[parameters('diskStorageType')]"
      },
      "tags": {
        "CostCenter": "000",
        "Environment": "Development",
        "Service": "SCOLP",
        "Owner": "MDTP"
      }
    }
  ],
  "outputs": {}
}